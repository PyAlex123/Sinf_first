{
  "name": "@sinf/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API, WebSocket and static web in one Node process (ADR-004)",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@sinf/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx --conditions=@sinf/source src/cli/seed.ts",
    "import:html": "tsx --conditions=@sinf/source src/cli/import-html.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@sinf/shared": "workspace:*",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "parse5": "^8.1.1",
    "pino-pretty": "^13.2.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.2"
  }
}
