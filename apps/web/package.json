  },
  "dependencies": {
    "@sinf/shared": "workspace:*",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.7.8",
    "vite": "^8.3.8"
  }
}
