{
  "name": "@sinf/checkers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Practice file checkers (docx, xlsx, pptx, html/css, txt) — ADR-003, ADR-016. Run unchanged in the browser and in Node.",
  "exports": {
    ".": {
      "@sinf/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sinf/shared": "workspace:*",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "domhandler": "^6.0.1"
  }
}
