# Copy to .env and adjust. Never commit .env.

# HTTP server (API, WebSocket and built web on one port — ADR-004)
PORT=3000
HOST=0.0.0.0

# Local storage instead of S3/PostgreSQL (stage 1)
DATA_DIR=data
DATABASE_PATH=data/sinf.db
# Imported lessons (ADR-005)
CONTENT_DIR=content
# Built web client (pnpm build); served by the server when present
WEB_DIR=apps/web/dist

# Demo teacher account (login: demo@sinf.local)
DEMO_TEACHER_PASSWORD=demo1234

# Our own account (S2.3): only it creates schools and assigns their administrators.
# Leave both empty and no superadmin exists; the /admin area then answers 404 to everyone.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Secret for signing session cookies. Use a long random string outside local demos.
SESSION_SECRET=change-me-to-a-long-random-string

# School-computer mode (S2.6). Empty on the platform itself.
# The Windows app passes PLATFORM_CONFIG_FILE — the path to its own config.json, where the platform
# address and this machine's token already live (S2.4). The two variables below say the same thing
# by hand, for development: with them the server mirrors its school's roster and sends lesson
# results up as soon as there is a connection.
PLATFORM_CONFIG_FILE=
PLATFORM_URL=
DEVICE_TOKEN=

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
