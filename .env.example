# Copy to .env and adjust. Never commit .env.

# HTTP server (API, WebSocket and built web on one port — ADR-004)
PORT=3000
HOST=0.0.0.0

# Local storage instead of S3/PostgreSQL (stage 1)
DATA_DIR=data
DATABASE_PATH=data/sinf.db
# Imported lessons (ADR-005)
CONTENT_DIR=content
# Built web client (pnpm build); served by the server when present
WEB_DIR=apps/web/dist

# Demo teacher account (login: demo@sinf.local)
DEMO_TEACHER_PASSWORD=demo1234

# Secret for signing session cookies. Use a long random string outside local demos.
SESSION_SECRET=change-me-to-a-long-random-string

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
