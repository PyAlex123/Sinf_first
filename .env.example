# Copy to .env and adjust. Never commit .env.

# HTTP server (API, WebSocket and built web on one port — ADR-004)
PORT=3000
HOST=0.0.0.0

# Local storage instead of S3/PostgreSQL (stage 1)
DATA_DIR=data
DATABASE_PATH=data/sinf.db
# Imported lessons (ADR-005)
CONTENT_DIR=content
# Built web client (pnpm build); served by the server when present
WEB_DIR=apps/web/dist

# Demo teacher account (login: demo@sinf.local)
DEMO_TEACHER_PASSWORD=demo1234

# Our own account (S2.3): only it creates schools and assigns their administrators.
# Leave both empty and no superadmin exists; the /admin area then answers 404 to everyone.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Secret for signing session cookies. Use a long random string outside local demos.
SESSION_SECRET=change-me-to-a-long-random-string

# School-computer mode (S2.6). Empty on the platform itself.
# The Windows app passes PLATFORM_CONFIG_FILE — the path to its own config.json, where the platform
# address and this machine's token already live (S2.4). The two variables below say the same thing
# by hand, for development: with them the server mirrors its school's roster and sends lesson
# results up as soon as there is a connection.
PLATFORM_CONFIG_FILE=
PLATFORM_URL=
DEVICE_TOKEN=

# Teacher's computer in a classroom (stage 3, ADR-014): student computers ask it which lesson to
# open, with no lesson code, and their seats are remembered. The Windows app sets 1 by itself.
# Never on the platform: it would show any running lesson's class list to anyone who asks.
CLASSROOM_MODE=0

# "Forgot the password" letters (stage 5, A7). Empty SMTP_URL — the letter is written to the log
# (development, a school computer); a school administrator can always give a reset link instead.
# SMTP_URL=smtp://user:password@smtp.example.com:587   (or smtps://… for port 465)
SMTP_URL=
MAIL_FROM=Sinf <no-reply@example.com>
# The site's address for links in letters (https://sinf.uz). Empty — taken from the request.
PUBLIC_URL=

# Updates of the Windows app (stage 6, B6; ADR-023): the public half of the signing key, as
# `node tools/update-key.mjs` prints it. With it the site refuses an unsigned upload in /admin.
# Empty — only the computers check the signature (they always do).
UPDATE_PUBLIC_KEY=

# Login cookies and a reverse proxy (review 2026-11-25).
# COOKIE_SECURE: auto — the cookie is Secure when the request came over HTTPS (works both by plain
# http://IP and behind HTTPS); 1 — always; 0 — never.
COOKIE_SECURE=auto
# TRUST_PROXY=1 only behind a reverse proxy (deploy/docker-compose.yml sets it for Caddy): the
# visitor's address and protocol are then taken from X-Forwarded-*. Never when the server faces the
# network itself — anyone could claim another address.
TRUST_PROXY=0

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
